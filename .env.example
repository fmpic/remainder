PORT=3000
# 默认只监听本机；局域网/容器使用 HOST=0.0.0.0 时必须配置用户名和密码
HOST=127.0.0.1
TZ=Asia/Shanghai
DB_PATH=./data/esim.db

# Telegram Bot 配置（也可以直接在网页设置中配置并保存到数据库）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 每日提醒时间（按配置时区，默认 09:00）
NOTIFY_HOUR=9
NOTIFY_MINUTE=0

# 登录认证配置（同时设置用户名和密码后开启网页登录保护；留空则免登录）
AUTH_USERNAME=admin
AUTH_PASSWORD=
# 可选：用于签名登录 Cookie 的密钥（建议生产环境设置固定随机字符串）
AUTH_SECRET=
